<Window x:Class="DualRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dual Recorder - mic + system audio" Height="560" Width="620"
        MinHeight="520" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F7F9">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- devices -->
        <StackPanel Grid.Row="0">
            <Label Content="Microphone"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="MicCombo" Height="26"/>
                <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh" MinWidth="70"
                        Margin="8,0,0,0" Padding="10,3" Click="RefreshButton_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <Label Content="Speakers / system audio (recorded by loopback)"/>
            <ComboBox x:Name="SysCombo" Height="26"/>
        </StackPanel>

        <!-- output folder -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Label Content="Save recordings to"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" Height="26" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="Browse" MinWidth="70" Margin="8,0,0,0"
                        Padding="10,3" Click="Browse_Click"/>
                <Button Grid.Column="2" Content="Open" MinWidth="60" Margin="0"
                        Padding="10,3" Click="OpenFolder_Click"/>
            </Grid>
        </StackPanel>

        <!-- mp3 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
            <CheckBox x:Name="Mp3Check" Content="Also export MP3 copies" VerticalAlignment="Center"/>
            <TextBlock Text="Bitrate" Margin="18,0,6,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="BitrateCombo" Width="80" Height="24" VerticalAlignment="Center">
                <ComboBoxItem Content="128"/>
                <ComboBoxItem Content="192" IsSelected="True"/>
                <ComboBoxItem Content="256"/>
                <ComboBoxItem Content="320"/>
            </ComboBox>
        </StackPanel>

        <!-- timer -->
        <Border Grid.Row="4" Margin="0,16,0,0" Background="White" BorderBrush="#FFDDDDE3"
                BorderThickness="1" CornerRadius="6" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TimerText" Text="00:00:00.0" FontSize="30" FontFamily="Consolas"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="StateText" Text="Ready" FontSize="14"
                           Foreground="#FF5A5A66" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- meters -->
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Microphone" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <ProgressBar Grid.Column="1" x:Name="MicMeter" Height="18" Minimum="0" Maximum="100"
                         Margin="0,0,0,8" Foreground="#FF2E9E5B"/>
            <TextBlock Grid.Column="2" x:Name="MicDb" Text="-inf" TextAlignment="Right"
                       VerticalAlignment="Center" Margin="6,0,0,8" FontFamily="Consolas"/>

            <TextBlock Grid.Row="1" Text="System audio" VerticalAlignment="Center"/>
            <ProgressBar Grid.Row="1" Grid.Column="1" x:Name="SysMeter" Height="18" Minimum="0"
                         Maximum="100" Foreground="#FF2E6FCC"/>
            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SysDb" Text="-inf" TextAlignment="Right"
                       VerticalAlignment="Center" Margin="6,0,0,0" FontFamily="Consolas"/>
        </Grid>

        <!-- transport -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,18,0,0">
            <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" FontWeight="Bold"/>
            <Button x:Name="PauseButton" Content="Pause" Click="PauseButton_Click" IsEnabled="False"/>
            <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="False"/>
            <TextBlock x:Name="HotkeyText" Text="Hotkey: Ctrl + Shift + R" VerticalAlignment="Center"
                       Margin="12,0,0,0" Foreground="#FF5A5A66"/>
        </StackPanel>

        <!-- log -->
        <Border Grid.Row="7" Margin="0,14,0,0" Background="White" BorderBrush="#FFDDDDE3"
                BorderThickness="1" CornerRadius="6">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="10,8">
                <TextBlock x:Name="LogText" TextWrapping="Wrap" FontSize="12" Foreground="#FF3A3A44"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
