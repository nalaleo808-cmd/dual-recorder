<Window x:Class="DualRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dual Recorder - live transcript" Height="790" Width="1120"
        MinHeight="680" MinWidth="940" WindowStartupLocation="CenterScreen" Background="#FFF7F7F9">
    <Grid Margin="16" Background="#FFF7F7F9">
        <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0,0,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Label Content="Microphone"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="MicCombo" Height="26"/>
                    <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh" MinWidth="70" Margin="8,0,0,0" Padding="10,3" Click="RefreshButton_Click"/>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <Label Content="Speakers / system audio"/>
                <ComboBox x:Name="SysCombo" Height="26"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Label Content="Save recordings to"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Height="26" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Browse" MinWidth="65" Margin="8,0,0,0" Padding="8,3" Click="Browse_Click"/>
                    <Button Grid.Column="2" Content="Open" MinWidth="55" Margin="0" Padding="8,3" Click="OpenFolder_Click"/>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                <CheckBox x:Name="Mp3Check" Content="Also export MP3 copies" VerticalAlignment="Center"/>
                <TextBlock Text="Bitrate" Margin="12,0,6,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="BitrateCombo" Width="65" Height="24" VerticalAlignment="Center">
                    <ComboBoxItem Content="128"/><ComboBoxItem Content="192" IsSelected="True"/>
                    <ComboBoxItem Content="256"/><ComboBoxItem Content="320"/>
                </ComboBox>
            </StackPanel>
            <Border Grid.Row="4" Margin="0,16,0,0" Background="White" BorderBrush="#FFDDDDE3" BorderThickness="1" CornerRadius="6" Padding="12,10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimerText" Text="00:00:00.0" FontSize="28" FontFamily="Consolas" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="StateText" Text="Ready" FontSize="14" Foreground="#FF5A5A66" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
            <Grid Grid.Row="5" Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                <TextBlock Text="Microphone" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <ProgressBar Grid.Column="1" x:Name="MicMeter" Height="18" Minimum="0" Maximum="100" Margin="0,0,0,8" Foreground="#FF2E9E5B"/>
                <TextBlock Grid.Column="2" x:Name="MicDb" Text="-inf" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,8" FontFamily="Consolas"/>
                <TextBlock Grid.Row="1" Text="System audio" VerticalAlignment="Center"/>
                <ProgressBar Grid.Row="1" Grid.Column="1" x:Name="SysMeter" Height="18" Minimum="0" Maximum="100" Foreground="#FF2E6FCC"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SysDb" Text="-inf" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0" FontFamily="Consolas"/>
            </Grid>
            <StackPanel Grid.Row="6" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" FontWeight="Bold"/>
                    <Button x:Name="PauseButton" Content="Pause" Click="PauseButton_Click" IsEnabled="False"/>
                    <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="HotkeyText" Text="Hotkey: Ctrl + Shift + R" Margin="0,8,0,0" Foreground="#FF5A5A66"/>
            </StackPanel>
            <Border Grid.Row="7" Margin="0,14,0,0" Background="White" BorderBrush="#FFDDDDE3" BorderThickness="1" CornerRadius="6">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <TextBlock x:Name="LogText" TextWrapping="Wrap" FontSize="12" Foreground="#FF3A3A44"/>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Column="1" Background="White" BorderBrush="#FFDDDDE3" BorderThickness="1" CornerRadius="6" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Live transcript" FontSize="21" FontWeight="Bold"/>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <CheckBox x:Name="TranscriptCheck" Content="Transcribe while recording" IsChecked="True"/>
                    <TextBlock Text="English speech is processed on this PC. Setup downloads speech files once (about 106 MB)." TextWrapping="Wrap" Foreground="#FF5A5A66" Margin="0,6,0,8"/>
                    <Button x:Name="ModelsButton" Content="Set up speech files" HorizontalAlignment="Left" Click="ModelsButton_Click"/>
                    <TextBlock x:Name="TranscriptStatus" Text="Set up speech files to enable live transcription." TextWrapping="Wrap" Foreground="#FF2E6FCC" Margin="0,8,0,0"/>
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="OnlyMeCheck" Content="Only me on the microphone" IsChecked="True" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="MicrophoneNameBox" Text="You" Margin="8,0,0,0" Height="26" VerticalContentAlignment="Center" ToolTip="Your microphone name. Untick the checkbox for meetings with several people in the room."/>
                </Grid>
                <TextBlock Grid.Row="3" Text="Live text and speaker labels can change. Rename speakers below. Short sections and overlapping voices may need review." TextWrapping="Wrap" Foreground="#FF5A5A66" Margin="0,10,0,0"/>
                <Grid Grid.Row="4" Margin="0,12,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="SpeakerCombo" Height="28" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                    <TextBox Grid.Column="1" x:Name="SpeakerNameBox" Height="28" Margin="6,0,0,0" VerticalContentAlignment="Center" ToolTip="Type the person's name"/>
                    <Button Grid.Column="2" Content="Rename" Click="RenameSpeaker_Click" Margin="6,0,0,0"/>
                </Grid>
                <ListView Grid.Row="5" x:Name="TranscriptList" BorderBrush="#FFE4E4EA" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,6,6,8">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" FontFamily="Consolas" Foreground="#FF5A5A66"/>
                                <TextBlock Grid.Column="1" Text="{Binding SpeakerName}" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#FF5A5A66" FontSize="11" TextAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#FF777780" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="SaveTranscriptButton" Content="Save transcript" Click="SaveTranscript_Click" IsEnabled="False"/>
                    <Button x:Name="OpenTranscriptButton" Content="Open transcript" Click="OpenTranscript_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
